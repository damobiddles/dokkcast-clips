{
  "studio": {
    "name": "Offcuts",
    "tagline": "by MBMS · one episode in, a month of marketing out",
    "logo": "assets/brand/offcuts-icon.svg",
    "icon": "assets/brand/offcuts-icon.png",
    "fonts_css": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap",
    "font": "Inter, system-ui, sans-serif",
    "headline_font": "Poppins, Inter, sans-serif",
    "colors": {"bg": "#17161C", "panel": "#201F27cc", "line": "#33323C", "text": "#F3F2EE", "dim": "#A8A6B0", "track": "#33323C",
               "accent": "#5FCF95", "on_accent": "#17161C", "field": "#121116", "button": "#26252E", "button_line": "#3B3A45",
               "code": "#0F0E13", "ok": "#5FCF95", "warn": "#FF8A8A", "wait": "#FFD27A"},
    "look": {"border": "1px", "shadow": "none", "radius": "12px", "button_radius": "8px", "button_border": "1px",
             "button_shadow": "none", "scheme": "dark", "noise": false,
             "bg_image": "radial-gradient(70% 55% at 12% 0%, rgba(95,207,149,.10), transparent 70%), radial-gradient(60% 50% at 95% 100%, rgba(95,207,149,.06), transparent 70%), linear-gradient(160deg, #1E1D25 0%, #17161C 45%, #121116 100%)"}
  },
  "show": {"name": "The Dokkcast", "kicker": "The Dokkcast", "zip": "Dokkcast posts"},
  "canvas": {
    "width": 1080,
    "height": 1920,
    "bg_top": "#0A0F2C",
    "bg_bottom": "#251A63"
  },
  "logo": {
    "file": "assets/logo/udokk_logo_gradient.svg",
    "width": 380
  },
  "captions": {
    "font_family": "Manrope ExtraBold",
    "size": 84,
    "color": "#FFFFFF",
    "highlight": "#75C0FB",
    "outline": 0,
    "shadow": 2,
    "margin_x": 90,
    "max_words": 4,
    "max_chars": 30
  },
  "models": {
    "whisper_dir": "models/whisper-small.en",
    "ctc_dir": "models/ctc-conformer-small",
    "diar_dir": "models/diar"
  },
  "layouts": {
    "wide": {
      "follow": false,
      "crop": "auto",
      "video_y_offset": 0,
      "logo_center_y": 330,
      "captions_center_y": 1560
    },
    "speaker": {
      "follow": true,
      "crop": "auto",
      "window_width": 1160,
      "video_center_y": 980,
      "logo_center_y": 270,
      "captions_center_y": 1610,
      "speaker_x": {
        "left": 0.3,
        "right": 0.73
      },
      "speaker_sides": "auto",
      "min_hold": 0.8,
      "lead": 0.15,
      "pan_seconds": 0.5
    },
    "square": {
      "follow": false,
      "crop": "auto",
      "video_y_offset": -10,
      "canvas": {
        "width": 1080,
        "height": 1080
      },
      "captions": {
        "size": 62,
        "max_chars": 28
      },
      "logo": {
        "width": 200
      },
      "logo_center_y": 125,
      "captions_center_y": 960
    },
    "landscape": {
      "follow": false,
      "crop": "auto",
      "video_y_offset": 0,
      "canvas": {
        "width": 1920,
        "height": 1080
      },
      "captions": {
        "size": 66,
        "max_chars": 34,
        "shadow": 3,
        "outline": 3
      },
      "logo": {
        "width": 150
      },
      "logo_x": "W-w-56",
      "logo_center_y": 125,
      "captions_center_y": 950
    }
  },
  "clips": {
    "formats": {
      "portrait": "speaker",
      "square": "square"
    },
    "music": {
      "on": true,
      "level_db": -12,
      "duck_ratio": 2,
      "fade": 1.0,
      "offset_step": 30
    }
  },
  "episode": {
    "pause_max": 1.0,
    "pause_keep": 0.4,
    "fillers": [
      "um",
      "uh",
      "uhm",
      "umm",
      "erm",
      "er",
      "ah",
      "hmm",
      "mm"
    ],
    "audio": "highpass=f=80,afftdn=nr=10:nf=-40:tn=1,deesser=i=0.3,acompressor=threshold=0.1:ratio=3:attack=10:release=150:makeup=2,loudnorm=I=-16:TP=-1.5:LRA=11",
    "music": {
      "dir": "assets/music",
      "level_db": -24,
      "intro_seconds": 20,
      "outro_seconds": 20,
      "fade": 3
    },
    "lower_third_seconds": 6,
    "video": [
      "-c:v",
      "libx264",
      "-crf",
      "18",
      "-preset",
      "fast"
    ],
    "spellings": {
      "doc cast": "Dokkcast",
      "dock cast": "Dokkcast",
      "dokcast": "Dokkcast",
      "docast": "Dokkcast",
      "u dock": "udokk",
      "you dock": "udokk",
      "dot cast": "Dokkcast",
      "marston": "Marsden",
      "marlston": "Marsden",
      "sana banerjee": "Susana Banerjee",
      "guiney": "gynae",
      "gynic": "gynae"
    }
  },
  "social": {
    "platforms": [
      "tiktok",
      "instagram",
      "youtube",
      "linkedin"
    ],
    "shapes": {
      "tiktok": "portrait",
      "instagram": "portrait",
      "youtube": "portrait",
      "linkedin": "square"
    },
    "tz": "Europe/London",
    "time": "12:00",
    "days": "mon,tue,wed,thu,fri", "off": [["12-24", "01-01"]],
    "channels": {},
    "settings": {
      "tiktok": {
        "privacy_level": "PUBLIC_TO_EVERYONE",
        "content_posting_method": "DIRECT_POST",
        "duet": false,
        "stitch": false,
        "comment": true,
        "autoAddMusic": "no",
        "brand_content_toggle": false,
        "brand_organic_toggle": false
      },
      "instagram": {
        "post_type": "post"
      },
      "youtube": {
        "type": "public"
      },
      "linkedin": {}
    }
  }
}
